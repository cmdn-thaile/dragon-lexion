# ---- Auth0 (Regular Web Application) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte random hex: openssl rand -hex 32
AUTH0_SECRET=
# Local: http://localhost:3000  |  Vercel: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# ---- MongoDB Atlas (database name in the path) ----
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dragon-lexicon?retryWrites=true&w=majority"
